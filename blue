#!/usr/bin/env bash
# Blue launcher.
#   ./blue            foreground supervisor (terminal stays open)
#   ./blue --bg       background daemon: terminal exits at once, runs secretly
#   ./blue --stop     stop the daemon (wipes runtime data, same as Ctrl+C)
#   ./blue --log      show recent daemon log
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MASTER_PAT="blue_master.py"
LOG="$DIR/blue.log"

running_pid() { pgrep -f "$MASTER_PAT" | head -n 1; }

case "${1:-}" in
    --bg)
        P=$(running_pid)
        if [ -n "$P" ]; then
            echo "Stopping previous run (PID $P)..."
            kill "$P" 2>/dev/null
            pkill -f blue_notch 2>/dev/null
            for i in 1 2 3 4 5 6 7 8; do running_pid >/dev/null || break; sleep 1; done
        fi
        # Fresh log per run would hide history; append instead. Unbuffered (-u) so log is live.
        nohup python3 -u "$DIR/blue_master.py" --daemon >>"$LOG" 2>&1 < /dev/null &
        disown 2>/dev/null
        sleep 1
        P=$(running_pid)
        if [ -n "$P" ]; then echo "Apple running in background (PID $P). Log: blue.log"; else echo "Failed to start (see blue.log)"; exit 1; fi
        exit 0
        ;;
    --bg-plus|--plus)
        P=$(running_pid)
        if [ -n "$P" ]; then
            echo "Stopping previous run (PID $P)..."
            kill "$P" 2>/dev/null
            pkill -f blue_notch 2>/dev/null
            for i in 1 2 3 4 5 6 7 8; do running_pid >/dev/null || break; sleep 1; done
        fi
        nohup python3 -u "$DIR/blue_master.py" --daemon --plus >>"$LOG" 2>&1 < /dev/null &
        disown 2>/dev/null
        sleep 1
        P=$(running_pid)
        if [ -n "$P" ]; then echo "Apple running in background [PLUS MODE] (PID $P). Log: blue.log"; else echo "Failed to start (see blue.log)"; exit 1; fi
        exit 0
        ;;
    --stop)
        P=$(running_pid)
        if [ -z "$P" ]; then echo "Not running."; exit 0; fi
        kill "$P" 2>/dev/null
        for i in 1 2 3 4 5; do running_pid >/dev/null || break; sleep 1; done
        pkill -f blue_notch 2>/dev/null
        echo "Stopped."
        exit 0
        ;;
    --alpha)
        python3 "$DIR/alpha_solver.py"
        exit 0
        ;;
    --log)
        tail -n 60 "$LOG" 2>/dev/null || echo "No log yet."
        exit 0
        ;;
esac
exec python3 "$DIR/blue_master.py" "$@"
