{
  "manifest_version": 3,
  "name": "Blue",
  "version": "1.0.0",
  "description": "Blue",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:20261/*",
    "http://localhost:20261/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
